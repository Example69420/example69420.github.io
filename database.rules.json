{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[a-z0-9]{4}$/)",
        "meta": {
          ".write": "auth != null && $code.matches(/^[a-z0-9]{4}$/) && (!data.exists() || data.child('host').val() === auth.uid || !data.parent().child('players').child(data.child('host').val()).exists())",
          ".validate": "newData.hasChildren(['host', 'round', 'card', 'dealtAt']) && newData.child('host').val() === auth.uid",
          "host": { ".validate": "newData.isString()" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
          "card": { ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() < 1362" },
          "dealtAt": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === now)" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $code.matches(/^[a-z0-9]{4}$/)",
            ".validate": "newData.hasChildren(['name', 'color', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
            "color": { ".validate": "newData.isString() && newData.val().length <= 9" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        },
        "solves": {
          "$round": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($code).child('players').child($uid).exists()",
              ".validate": "newData.isNumber() && newData.val() === now && now <= root.child('rooms').child($code).child('meta').child('dealtAt').val() + 305000"
            }
          }
        }
      }
    }
  }
}
